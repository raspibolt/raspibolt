# RaspiBolt v4: environment variables
#
# Copy to `.env.local` (gitignored) and uncomment the lines you need.
# Every variable here is consumed by the Next.js build at compile time,
# not at runtime (this is a static export).

# Public site origin. Used for absolute URLs in metadata and the
# canonical link. Defaults to the staging deploy if unset.
# Set to https://raspibolt.org for production builds; this also flips
# `isProductionSite` (lib/shared.ts), which enables search indexing
# and switches Umami to the production website ID. The Umami script
# only renders in production builds (NODE_ENV=production) and is
# additionally pinned to the deploy hostname via data-domains, so
# `next dev` and locally served builds never hit the stats.
# NEXT_PUBLIC_SITE_URL=https://raspibolt.org

# Path prefix the site is served from. Required when the deploy host
# is not the domain root (e.g. GitHub Pages serves stadicus.github.io/RaspiBolt).
# Empty string for a root deploy. Set in CI via the publish workflow.
# NEXT_PUBLIC_BASE_PATH=/RaspiBolt
